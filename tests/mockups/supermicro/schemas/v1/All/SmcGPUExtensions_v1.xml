<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
  <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/errata03/csd01/complete/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Namespace="Org.OData.Core.V1" Alias="OData"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/Resource_v1.xml">
    <edmx:Include Namespace="Resource"/>
    <edmx:Include Namespace="Resource.v1_0_0"/>
  </edmx:Reference>

  <edmx:DataServices>
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="SmcGPUExtensions">
        <EntityType Name="SmcGPUExtensions" BaseType="Resource.v1_0_0.Resource">
        </EntityType>
    </Schema>
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="SmcGPUExtensions.v1_0_0">
        <ComplexType Name="GPU">
        <Property Name="GPUSlot" Type="Edm.Int64">
            <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
            <Annotation Term="OData.Description" String="GPU slot index."/>
            <Annotation Term="OData.LongDescription" String="The physical location of GPU in the system."/>
        </Property>
        <Property Name="Board part number" Type="Edm.String" Nullable="true">
            <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
            <Annotation Term="OData.Description" String="The GPU part number of this device."/>
            <Annotation Term="OData.LongDescription" String="This property shall indicate part number as provided by the manufacturer of this GPU."/>
        </Property>
        <Property Name="Driver" Type="Edm.String" Nullable="true">
            <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
            <Annotation Term="OData.Description" String="Driver status"/>
            <Annotation Term="OData.LongDescription" String="Check the driver status."/>
        </Property>
        <Property Name="Memory vendor" Type="Edm.String" Nullable="true">
            <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
            <Annotation Term="OData.Description" String="Memory Vendor Name"/>
            <Annotation Term="OData.LongDescription" String="Memory Vendor Name"/>
        </Property>
        <Property Name="Memory part number" Type="Edm.String" Nullable="true">
            <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
            <Annotation Term="OData.Description" String="The Memory part number on GPU."/>
            <Annotation Term="OData.LongDescription" String="This property shall indicate part number as provided by the manufacturer of this Memory on GPU."/>
        </Property>
        <Property Name="ECC statistic" Type="Edm.String" Nullable="true">
            <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
            <Annotation Term="OData.Description" String="The statistic of ECC."/>
            <Annotation Term="OData.LongDescription" String="The statistic of ECC."/>
        </Property>
        <Property Name="GPU GUID" Type="Edm.String" Nullable="true">
            <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
            <Annotation Term="OData.Description" String="The GUID of this device."/>
            <Annotation Term="OData.LongDescription" String="This property shall indicate GUID as provided by the manufacturer of this GPU."/>
        </Property>
        <Property Name="InfoROM version" Type="Edm.String" Nullable="true">
            <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
            <Annotation Term="OData.Description" String="GPU version."/>
            <Annotation Term="OData.LongDescription" String="This version was released from manufacturer of this device."/>
        </Property>
        <Property Name="Fru ID" Type="Edm.String" Nullable="true">
            <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
            <Annotation Term="OData.Description" String="FRU ID."/>
            <Annotation Term="OData.LongDescription" String="AMD Fru ID."/>
        </Property>
        </ComplexType>
    </Schema>
