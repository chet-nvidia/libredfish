<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
    <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/cs01/vocabularies/Org.OData.Core.V1.xml">
        <edmx:Include Namespace="Org.OData.Core.V1" Alias="OData"/>
    </edmx:Reference>
    <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/RedfishExtensions_v1.xml">
        <edmx:Include Namespace="RedfishExtensions.v1_0_0" Alias="Redfish"/>
    </edmx:Reference>
    <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/cs01/vocabularies/Org.OData.Measures.V1.xml">
        <edmx:Include Namespace="Org.OData.Measures.V1" Alias="OData.Measures"/>
    </edmx:Reference>
    <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/Resource_v1.xml">
        <edmx:Include Namespace="Resource.v1_0_0" />
    </edmx:Reference>

    <edmx:DataServices>
        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="Syslog">
            <EntityType Name="Syslog" BaseType="Resource.v1_0_0.Resource">
            </EntityType>
        </Schema>

        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="Syslog.v1_0_0">
            <EntityType Name="Syslog" BaseType="Syslog.Syslog">
                <Property Name="EnableSyslog" Type="Edm.Boolean" Nullable="false" DefaultValue="false">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
                    <Annotation Term="OData.Description" String="Syslog is enabled or not"/>
                    <Annotation Term="OData.LongDescription" String="If Syslog is enabled, a centralized authentication, authorization and accounting management for users is provided"/>
                </Property>
                <Property Name="SyslogPortNumber" Type="Edm.Int64" Nullable="false">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
                    <Annotation Term="OData.Description" String="The port number for Syslog server."/>
                    <Annotation Term="OData.LongDescription" String="The value of this property shall be in the range between 1~65535."/>
                </Property>
                <Property Name="SyslogServerIP" Type="Edm.String" Nullable="false">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
                    <Annotation Term="OData.Description" String="The IP address of the Syslog server."/>
                    <Annotation Term="OData.LongDescription" String="The value of this property shall be match the format of IP address."/>
                </Property>
            </EntityType>
        </Schema>

        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="Syslog.v1_0_1">
            <EntityType Name="Syslog" BaseType="Syslog.v1_0_0.Syslog">
                <Property Name="SyslogServer" Type="Edm.String" Nullable="false">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
                    <Annotation Term="OData.Description" String="The Syslog server."/>
                    <Annotation Term="OData.LongDescription" String="The value of this property shall be match the format of FQDN."/>
                </Property>
            </EntityType>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>
