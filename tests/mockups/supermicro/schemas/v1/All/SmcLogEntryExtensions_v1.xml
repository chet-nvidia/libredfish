                 <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/Read"/>
                 <Annotation Term="OData.Description" String="The property represents the Category of Sensor Type."/>
                 <Annotation Term="OData.LongDescription" String="The property represents the Category of Sensor Type."/>
