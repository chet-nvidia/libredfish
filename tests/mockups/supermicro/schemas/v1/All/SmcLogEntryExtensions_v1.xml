            <Property Name="SensorType" Type="Edm.String" Nullable="false">
              <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/Read"/>
            </Property>
      </ComplexType>
    </Schema>
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="SmcLogEntryExtensions.v1_0_0">
     <ComplexType Name="LogEntry">
        <Property Name="MarkAsAcknowledged" Type="Edm.Boolean" Nullable="false">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
          <Annotation Term="OData.Description" String="Indicates if the log is Acknowledged for this entry."/>
          <Annotation Term="OData.LongDescription" String="The value of this property shall contain the Acknowledged status of the log for the entry.  The value shall be true if Acknowledged and false if Non-Acknowledged."/>
