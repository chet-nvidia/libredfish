<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">

  <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/cs01/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Namespace="Org.OData.Core.V1" Alias="OData"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/RedfishExtensions_v1.xml">
    <edmx:Include Namespace="RedfishExtensions.v1_0_0" Alias="Redfish"/>
    <edmx:Include Namespace="Validation.v1_0_0" Alias="Validation"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/Resource_v1.xml">
    <edmx:Include Namespace="Resource.v1_0_0" />
  </edmx:Reference>

  <edmx:DataServices>
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="FilterRule">
      <EntityType Name="FilterRule" BaseType="Resource.v1_0_0.Resource">
        <Annotation Term="OData.Description" String="This schema defines a IP access policy resource."/>
        <Annotation Term="OData.LongDescription" String="This resource shall be used to represent IP access policy settings for the manager."/>
      </EntityType>
    </Schema>

    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="FilterRule.v1_0_0">
      <EntityType Name="FilterRule" BaseType="FilterRule.FilterRule">
        <Property Name="Address" Type="Edm.String">
          <Annotation Term="OData.Description" String="This is the IPv4 Address."/>
          <Annotation Term="OData.LongDescription" String="The value of this property shall be an IPv4 address assigned to this interface.  If DHCPv4 is enabled on the interface, this property becomes read-only."/>
          <Annotation Term="Redfish.Pattern" String="^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"/>
          <Annotation Term="Redfish.RequiredOnCreate"/>
        </Property>
        <Property Name="PrefixLength" Type="Edm.Int64">
          <Annotation Term="OData.Description" String="The Prefix Length of this IPv4 address."/>
          <Annotation Term="OData.LongDescription" String="Provides the IPv4 network prefix length in bits for this address."/>
          <Annotation Term="Validation.Minimum" Int="1"/>
          <Annotation Term="Validation.Maximum" Int="32"/>
          <Annotation Term="Redfish.RequiredOnCreate"/>
        </Property>
        <Property Name="Policy" Type="FilterRule.v1_0_0.Policy">
          <Annotation Term="OData.Description" String="The Policy of this IP access rule."/>
          <Annotation Term="OData.LongDescription" String="Provides the Policy to accept or deny access to this manager."/>
          <Annotation Term="Redfish.RequiredOnCreate"/>
        </Property>
      </EntityType>

      <EnumType Name="Policy">
        <Member Name="Accept"/>
        <Member Name="Drop"/>
      </EnumType>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
