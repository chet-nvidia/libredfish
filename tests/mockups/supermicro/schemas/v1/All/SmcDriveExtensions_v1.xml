  <edmx:DataServices>
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="SmcDriveExtensions">
        <EntityType Name="SmcDriveExtensions" BaseType="Resource.v1_0_0.Resource">
        </EntityType>
    </Schema>
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="SmcDriveExtensions.v1_0_0">
    <ComplexType Name="Drive">
        <Property Name="Temperature" Type="Edm.Int64">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/Read"/>
          <Annotation Term="OData.Description" String="Drive temperature"/>
          <Annotation Term="OData.LongDescription" String="Represent the temperature of this device."/>
          <Annotation Term="Measures.Unit" String="Deg"/>
        </Property>
        <Property Name="OtherErrCount" Type="Edm.Int64">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/Read"/>
          <Annotation Term="OData.Description" String="Other error count"/>
          <Annotation Term="OData.LongDescription" String="Transient errors detected, while communicating with this device."/>
          <Annotation Term="Measures.Unit" String="By"/>
        </Property>
        <Property Name="SmartEventReceived" Type="Edm.Int64">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/Read"/>
          <Annotation Term="OData.Description" String="Predicted fail count"/>
          <Annotation Term="OData.LongDescription" String="A property indicating the number of errors that have been detected on the disk media."/>
          <Annotation Term="Measures.Unit" String="By"/>
        </Property>
        <Property Name="MediaErrCount" Type="Edm.Int64">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/Read"/>
          <Annotation Term="OData.Description" String="Media error count"/>
          <Annotation Term="OData.LongDescription" String="The number of physical errors detected on the disk media."/>
          <Annotation Term="Measures.Unit" String="By"/>
        </Property>
    </ComplexType>
    </Schema>
