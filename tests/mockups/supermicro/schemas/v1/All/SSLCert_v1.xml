                </Property>
                <Property Name="Actions" Type="SSLCert.v1_0_0.Actions" Nullable="false">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/Read"/>
                    <Annotation Term="OData.Description" String="The Actions object contains the available custom actions on this resource."/>
                </Property>
            </EntityType>
            <ComplexType Name="Actions">
                <Annotation Term="OData.AdditionalProperties" Bool="False"/>
            </ComplexType>
            <EnumType Name="UploadKeyWords">
