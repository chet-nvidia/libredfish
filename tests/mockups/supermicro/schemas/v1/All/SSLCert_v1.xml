    <edmx:DataServices>
        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="SmcSSLCert">
            <EntityType Name="SmcSSLCert" BaseType="Resource.v1_0_0.Resource"></EntityType>
            <Action Name="Upload" IsBound="true">
                <Annotation Term="OData.Description" String="Upload operation for certification and private key update feature."/>
                <Annotation Term="OData.LongDescription" String="An action of certification and private key update."/>
                <Parameter Name="SmcSSLCert" Type="SSLCert.v1_0_0.Actions"/>
            </Action>
        </Schema>

        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="SSLCert">
            <EntityType Name="SSLCert" BaseType="Resource.v1_0_0.Resource"></EntityType>
