<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">

  <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/cs01/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Namespace="Org.OData.Core.V1" Alias="OData"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/RedfishExtensions_v1.xml">
    <edmx:Include Namespace="RedfishExtensions.v1_0_0" Alias="Redfish"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/cs01/vocabularies/Org.OData.Measures.V1.xml">
    <edmx:Include Namespace="Org.OData.Measures.V1" Alias="OData.Measures"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/Resource_v1.xml">
    <edmx:Include Namespace="Resource.v1_0_0" />
  </edmx:Reference>


  <edmx:DataServices>
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="NTP">
      <EntityType Name="NTP" BaseType="Resource.v1_0_0.Resource">
      </EntityType>
    </Schema>

    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="NTP.v1_0_0">

      <EntityType Name="NTP" BaseType="NTP.NTP">
        <Property Name="NTPEnable" Type="Edm.Boolean" Nullable="false">
            <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
            <Annotation Term="OData.Description" String="NTP（Network Time Protocol) service is enabled or not"/>
            <Annotation Term="OData.LongDescription" String="If NTP service is enabled, synchronising time over a network."/>
        </Property>
        <Property Name="PrimaryNTPServer" Type="Edm.String" Nullable="true">
            <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
            <Annotation Term="OData.Description" String="Primary NTP server ip address"/>
            <Annotation Term="OData.LongDescription" String="The value of this property shall be match the format of IP address or domain name."/>
        </Property>
        <Property Name="SecondaryNTPServer" Type="Edm.String" Nullable="true">
            <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
            <Annotation Term="OData.Description" String="Secondary NTP server ip address"/>
            <Annotation Term="OData.LongDescription" String="The value of this property shall be match the format of IP address or domain name."/>
        </Property>
        <Property Name="DaylightSavingTime" Type="Edm.Boolean">
            <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
            <Annotation Term="OData.Description" String="in Daylight Saving Time or not"/>
            <Annotation Term="OData.LongDescription" String="If it's in daylight saving time, the practice of advancing clocks during summer months by one hour so that in the evening day light is experienced an hour longer."/>
        </Property>
      </EntityType>
    </Schema>

    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="NTP.v1_0_1">
        <EntityType Name="NTP" BaseType="NTP.v1_0_0.NTP"/>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
