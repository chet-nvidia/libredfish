<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
  <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/errata03/csd01/complete/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Namespace="Org.OData.Core.V1" Alias="OData"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/cs01/vocabularies/Org.OData.Measures.V1.xml">
    <edmx:Include Namespace="Org.OData.Measures.V1" Alias="Measures"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/RedfishExtensions_v1.xml">
    <edmx:Include Namespace="RedfishExtensions.v1_0_0" Alias="Redfish"/>
    <edmx:Include Namespace="Validation.v1_0_0" Alias="Validation"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/Resource_v1.xml">
    <edmx:Include Namespace="Resource"/>
    <edmx:Include Namespace="Resource.v1_0_0" />
    <edmx:Include Namespace="Resource.v1_1_0" />
  </edmx:Reference>
  <edmx:Reference Uri="http://10.217.133.92/schemas/v1/VolumeConfig_v1.xml">
    <edmx:Include Namespace="VolumeConfig" />
    <edmx:Include Namespace="VolumeConfig.v1_0_0"/>
  </edmx:Reference>

  <edmx:DataServices>
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="SmcStorageExtensions">
        <EntityType Name="SmcStorageExtensions" BaseType="Resource.v1_0_0.Resource">
        </EntityType>
    </Schema>
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="SmcStorageExtensions.v1_0_0">
    <ComplexType Name="Storage">
      <Action Name="ClearVolumes">
        <Parameter Name="ControllerId" Type="Edm.Decimal">
          <Annotation Term="OData.Description" String="The controller ID to set on the storage subsytem."/>
          <Annotation Term="OData.LongDescription" String="This defines the property name for the action."/>
        </Parameter>
        <Annotation Term="OData.Description" String="This action is used to clear all the volumes."/>
        <Annotation Term="OData.LongDescription" String="This defines the name of the custom action supported on this resource."/>
      </Action>

      <Action Name="CreateVolume">
        <Parameter Name="ControllerId" Type="Edm.Decimal">
          <Annotation Term="OData.Description" String="The controller ID to set on the storage subsytem."/>
          <Annotation Term="OData.LongDescription" String="This defines the property name for the action."/>
        </Parameter>
        <Parameter Name="Raid" Type="VolumeConfig.RaidLevel">
          <Annotation Term="OData.Description" String="The raid level for the created volume."/>
          <Annotation Term="OData.LongDescription" String="This defines the property name for the action."/>
        </Parameter>
        <Parameter Name="Span" Type="Edm.Decimal">
          <Annotation Term="OData.Description" String="Physical disk per span."/>
          <Annotation Term="OData.LongDescription" String="This defines the physical disk per span for the action."/>
        </Parameter>
        <Parameter Name="PhysicalDrives" Type="Collection(Edm.String)">
          <Annotation Term="OData.Description" String="The disk index collection to create volume"/>
          <Annotation Term="OData.LongDescription" String="This defines the property name for the action."/>
        </Parameter>
        <Parameter Name="UsePercentage" Type="Edm.Decimal">
          <Annotation Term="OData.Description" String="Disk percentage to use."/>
          <Annotation Term="OData.LongDescription" String="This defines the disk percentage to use for the action. Positive integer only."/>
        </Parameter>
        <Parameter Name="LogicalDriveCount" Type="Edm.Decimal">
          <Annotation Term="OData.Description" String="New logical drive count."/>
          <Annotation Term="OData.LongDescription" String="This defines the new logical drive count for the action. Max LDs: 16."/>
        </Parameter>
        <Parameter Name="StripSizePerDDF" Type="VolumeConfig.StripSize">
          <Annotation Term="OData.Description" String="Strip size per DDF."/>
          <Annotation Term="OData.LongDescription" String="This defines the strip size per DDF for the action. Default: 256K."/>
        </Parameter>
        <Parameter Name="LdReadPolicy" Type="VolumeConfig.LdReadPolicy">
          <Annotation Term="OData.Description" String="Logical disk read policy."/>
          <Annotation Term="OData.LongDescription" String="This defines the logical disk read polilcy for the action. Default: NoReadAhead."/>
        </Parameter>
        <Parameter Name="LdWritePolicy" Type="VolumeConfig.LdWritePolicy">
          <Annotation Term="OData.Description" String="Logical disk write policy."/>
          <Annotation Term="OData.LongDescription" String="This defines the logical disk write policy for the action. Default: WriteBack."/>
        </Parameter>
        <Parameter Name="LdIOPolicy" Type="VolumeConfig.LdIOPolicy">
          <Annotation Term="OData.Description" String="Logical disk IO policy."/>
          <Annotation Term="OData.LongDescription" String="This defines the logical disk IO policy for the action. Default: DirectIO."/>
        </Parameter>
        <Parameter Name="AccessPolicy" Type="VolumeConfig.AccessPolicy">
          <Annotation Term="OData.Description" String="Access policy."/>
          <Annotation Term="OData.LongDescription" String="This defines the access policy for the action. Default: ReadWrite."/>
        </Parameter>
        <Parameter Name="DiskCachePolicy" Type="VolumeConfig.DiskCachePolicy">
          <Annotation Term="OData.Description" String="Disk cache policy."/>
          <Annotation Term="OData.LongDescription" String="This defines the disk cache policy for the action. Default: Enable."/>
        </Parameter>
        <Parameter Name="InitState" Type="VolumeConfig.InitState">
          <Annotation Term="OData.Description" String="Init state."/>
          <Annotation Term="OData.LongDescription" String="This defines the init state for the action. Default: NoInit."/>
        </Parameter>
        <Annotation Term="OData.Description" String="This action is used to create a new volume."/>
        <Annotation Term="OData.LongDescription" String="This defines the name of the custom action supported on this resource."/>
      </Action>
    </ComplexType>
    <ComplexType Name="StorageController">
      <Property Name="BIOSBootMode" Type="Edm.String">
        <Annotation Term="OData.Description" String="BIOS boot mode of the storage controller."/>
      </Property>
      <Property Name="JBODMode" Type="Edm.String">
        <Annotation Term="OData.Description" String="JBOD mode(Enable/Disable) of the storage controller."/>
      </Property>
      <ComplexType Name="BBU">
        <Annotation Term="OData.Description" String="Current status of BBU."/>
        <Annotation Term="OData.LongDescription" String="This information contains its real situation and brief status."/>
        <Property Name="BBUStatus" Type="SmcStorageExtensions.v1_0_0.BBUStatus">
        </Property>
        <Property Name="Status" Type="Resource.Status" Nullable="false">
          <Annotation Term="OData.Description" String="This property describes the status and health of the resource and its children."/>
          <Annotation Term="OData.LongDescription" String="This property shall contain any status or health properties of the resource."/>
        </Property>
      </ComplexType>

      <EnumType Name="BBUStatus">
        <Member Name="Missing">
        </Member>
        <Member Name="Charging">
        </Member>
        <Member Name="Discharging">
        </Member>
        <Member Name="Optimal">
        </Member>
        <Member Name="Needs To Be Replaced">
        </Member>
        <Member Name="Voltage Low">
        </Member>
        <Member Name="UnKnow">
        </Member>
        <Member Name="Not install">
        </Member>
        <Member Name="Error">
        </Member>
      </EnumType>
    </ComplexType>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
