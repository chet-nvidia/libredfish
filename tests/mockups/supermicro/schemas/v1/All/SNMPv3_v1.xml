<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
    <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/cs01/vocabularies/Org.OData.Core.V1.xml">
        <edmx:Include Namespace="Org.OData.Core.V1" Alias="OData"/>
    </edmx:Reference>
    <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/RedfishExtensions_v1.xml">
        <edmx:Include Namespace="RedfishExtensions.v1_0_0" Alias="Redfish"/>
    </edmx:Reference>
    <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/cs01/vocabularies/Org.OData.Measures.V1.xml">
        <edmx:Include Namespace="Org.OData.Measures.V1" Alias="OData.Measures"/>
    </edmx:Reference>
    <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/Resource_v1.xml">
        <edmx:Include Namespace="Resource.v1_0_0" />
    </edmx:Reference>

    <edmx:DataServices>
        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="SNMPv3">
            <EntityType Name="SNMPv3" BaseType="Resource.v1_0_0.Resource">
            </EntityType>
        </Schema>

        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="SNMPv3.v1_0_0">
            <EntityType Name="SNMPv3" BaseType="SNMPv3.SNMPv3">
                <Property Name="Snmpv3Enabled" Type="Edm.Boolean" Nullable="false" DefaultValue="false">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
                    <Annotation Term="OData.Description" String="SNMPv3 is enabled or not."/>
                </Property>
                <Property Name="UserName" Type="Edm.String" Nullable="true">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
                    <Annotation Term="OData.Description" String="The user name for your SNMPv3 request."/>
                </Property>
                <Property Name="AuthProtocol" Type="SNMPv3.v1_0_0.AuthType" Nullable="true">
                </Property>
                <Property Name="PrivateProtocol" Type="SNMPv3.v1_0_0.PrivateType" Nullable="true">
                </Property>
                <Property Name="AuthKey" Type="Edm.String" Nullable="true">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
                    <Annotation Term="OData.Description" String="A SNMPv3 authentication key."/>
                </Property>
                <Property Name="PrivateKey" Type="Edm.String" Nullable="true">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
                    <Annotation Term="OData.Description" String="A SNMPv3 private key."/>
                </Property>
            </EntityType>
            <EnumType Name="AuthType">
                <Member Name="MD5">
                </Member>
                <Member Name="SHA1">
                </Member>
            </EnumType>
            <EnumType Name="PrivateType">
                <Member Name="DES">
                </Member>
                <Member Name="AES">
                </Member>
            </EnumType>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>
