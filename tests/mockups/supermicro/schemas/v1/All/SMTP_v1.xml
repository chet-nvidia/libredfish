<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
    <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/cs01/vocabularies/Org.OData.Core.V1.xml">
        <edmx:Include Namespace="Org.OData.Core.V1" Alias="OData"/>
    </edmx:Reference>
    <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/RedfishExtensions_v1.xml">
        <edmx:Include Namespace="RedfishExtensions.v1_0_0" Alias="Redfish"/>
    </edmx:Reference>
    <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/cs01/vocabularies/Org.OData.Measures.V1.xml">
        <edmx:Include Namespace="Org.OData.Measures.V1" Alias="OData.Measures"/>
    </edmx:Reference>
    <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/Resource_v1.xml">
        <edmx:Include Namespace="Resource.v1_0_0" />
    </edmx:Reference>

    <edmx:DataServices>
        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="SMTP">
            <EntityType Name="SMTP" BaseType="Resource.v1_0_0.Resource">
            </EntityType>
        </Schema>

        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="SMTP.v1_0_0">
            <EntityType Name="SMTP" BaseType="SMTP.SMTP">
                <Property Name="SmtpSSLEnabled" Type="Edm.Boolean" Nullable="false" DefaultValue="false">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
                    <Annotation Term="OData.Description" String="SMTP SSL Authentication is enabled or not"/>
                    <Annotation Term="OData.LongDescription" String="If SMTP SSL Authentication is enabled, mail will be sent in a secured way to prevent being peeked mail content."/>
                </Property>
                <Property Name="SmtpServer" Type="Edm.String" Nullable="true">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
                    <Annotation Term="OData.Description" String="The address for the SMTP (Simple Mail Transfer Protocol) Mail server."/>
                    <Annotation Term="OData.LongDescription" String="The value of this property shall be match the format of IP address or domain name."/>
                </Property>
                <Property Name="SmtpPortNumber" Type="Edm.Int64" Nullable="false" DefaultValue="587">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
                    <Annotation Term="OData.Description" String="The port number for your SMTP Mail server."/>
                    <Annotation Term="OData.LongDescription" String="The value of this property shall be in the range between 1~65535."/>
                </Property>
                <Property Name="SmtpUserName" Type="Edm.String" Nullable="true">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
                    <Annotation Term="OData.Description" String="The user name for your SMTP Mail server."/>
                    <Annotation Term="OData.LongDescription" String="The value of this property shall not contain special characteristics and its max length is 64."/>
                </Property>
                <Property Name="SmtpPassword" Type="Edm.String" Nullable="true">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
                    <Annotation Term="OData.Description" String="The user password for your SMTP Mail server."/>
                    <Annotation Term="OData.LongDescription" String="The value of this property shall not contain special characteristics and its max length is 64."/>
                </Property>
                <Property Name="SmtpSenderAddress" Type="Edm.String" Nullable="false">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
                    <Annotation Term="OData.Description" String="The sender mail server."/>
                    <Annotation Term="OData.LongDescription" String="The value of this property shall be match the format of email."/>
                </Property>
            </EntityType>
        </Schema>

        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="SMTP.v1_0_1">
            <EntityType Name="SMTP" BaseType="SMTP.v1_0_0.SMTP">
                <Property Name="SmtpServer" Type="Edm.String" Nullable="true">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
                    <Annotation Term="OData.Description" String="The SMTP (Simple Mail Transfer Protocol) Mail server."/>
                    <Annotation Term="OData.LongDescription" String="The value of this property shall be match the format of FQDN."/>
                </Property>
            </EntityType>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>
