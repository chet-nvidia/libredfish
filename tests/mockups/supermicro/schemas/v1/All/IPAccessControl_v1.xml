  <edmx:DataServices>
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="IPAccessControl">
      <EntityType Name="IPAccessControl" BaseType="Resource.v1_0_0.Resource">
        <Annotation Term="OData.Description" String="This resource is used to obtain or modify the IP access control managed by a given manager."/>
        <Annotation Term="OData.LongDescription" String="This object shall be used to represent the IP access control settings for the manager."/>
      </EntityType>
    </Schema>

    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="IPAccessControl.v1_0_0">
      <EntityType Name="IPAccessControl" BaseType="IPAccessControl.IPAccessControl">
        <Property Name="ServiceEnabled" Type="Edm.Boolean" Nullable="false">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
          <Annotation Term="OData.Description" String="Indicates if the IP access control is enabled for this manager."/>
          <Annotation Term="OData.LongDescription" String="The value of this property shall contain the enabled status of the IP access control.  The value shall be true if enabled and false if disabled."/>
        </Property>
        <NavigationProperty Name="FilterRules" Type="FilterRuleCollection.FilterRuleCollection">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/Read"/>
          <Annotation Term="OData.Description" String="This is a reference to a collection of IP access setting that this manager uses for IP access control."/>
          <Annotation Term="OData.LongDescription" String="The value of this property shall be a link to a collection of type IPAccessControl which are for the use of this manager."/>
          <Annotation Term="OData.AutoExpandReferences"/>
        </NavigationProperty>
      </EntityType>
    </Schema>
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="IPAccessControl.v1_0_1">
      <EntityType Name="IPAccessControl" BaseType="IPAccessControl.v1_0_0.IPAccessControl">
        <Property Name="ServiceEnabled" Type="Edm.Boolean" Nullable="false">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/ReadWrite"/>
          <Annotation Term="OData.Description" String="Indicates if the IP access control is enabled for this manager."/>
          <Annotation Term="OData.LongDescription" String="The value of this property shall contain the enabled status of the IP access control.  The value shall be true if enabled and false if disabled."/>
        </Property>
        <NavigationProperty Name="FilterRules" Type="FilterRuleCollection.FilterRuleCollection">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permissions/Read"/>
          <Annotation Term="OData.Description" String="This is a reference to a collection of IP access setting that this manager uses for IP access control."/>
          <Annotation Term="OData.LongDescription" String="The value of this property shall be a link to a collection of type IPAccessControl which are for the use of this manager."/>
          <Annotation Term="OData.AutoExpandReferences"/>
        </NavigationProperty>
      </EntityType>
    </Schema>
  </edmx:DataServices>
