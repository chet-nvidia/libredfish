{
    "$schema": "http://redfish.dmtf.org/schemas/v1/redfish-schema.v1_1_0.json",
    "title": "#LenovoLED.v1_0_0.LenovoLED",
    "$ref": "#/definitions/LenovoLED",
    "definitions": {
        "LenovoLED": {
            "type": "object",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "additionalProperties": false,
            "properties": {
                "@odata.context": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/context"
                },
                "@odata.id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/id"
                },
                "@odata.type": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/type"
                },
                "Id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Id",
                    "description": "This indicates the LED ID."
                },
                "Description": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Description"
                },
                "Name": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Name"
                },
                "Color": {
                    "$ref": "#/definitions/LEDColor",
                    "readonly": true,
                    "description": "The LED color."
                },
                "State": {
                    "$ref": "#/definitions/LEDState",
                    "readonly": false,
                    "description": "The LED state. Only states of Check Log LED and Enclosure Identify LED are modifiable. Check Log LED can be turned off only, and Enclosure Identify LED can be turned on/off/blink"
                },
                "DutyCycle": {
                    "type": "number",
                    "readonly": true,
                    "description": "The LED duty cycle blinking ratio."
                },
                "PeriodInMillSec": {
                    "type": "number",
                    "readonly": true,
                    "description": "The blinking ratio period in millisecond units."
                },
                "Location": {
                    "type": "string",
                    "readonly": true,
                    "description": "The LED location according to LED SDR."
                },
                "EntityID": {
                    "type": "number",
                    "readonly": true,
                    "description": "The LED related device entity ID."
                },
                "EntityInstance": {
                    "type": "number",
                    "readonly": true,
                    "description": "The LED related device entity instance."
                },
                "DeviceEntity": {
                    "type": "string",
                    "readonly": true,
                    "description": "The LED related device entity."
                }
            },
            "description": "This resource represents the sensor.",
            "longDescription": "This resource shall be used to represent a sensor for an OEM implementation."
        },
        "LEDColor": {
            "type": "string",
            "enum": [
                "Red",
                "Orange",
                "Yellow",
                "Green",
                "Blue",
                "White"
            ]
        },
        "LEDState": {
            "type": "string",
            "enum": [
                "Off",
                "On",
                "Blink"
            ]
        }
    },
    "copyright": "Copyright (C) 2015 - present Lenovo.  All Rights reserved."
}