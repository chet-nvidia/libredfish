{
    "$schema": "http://redfish.dmtf.org/schemas/v1/redfish-schema.v1_1_0.json",
    "title": "#LenovoRemoteMapMedia.v1_0_0.LenovoRemoteMapMedia",
    "$ref": "#/definitions/LenovoRemoteMapMedia",
    "definitions": {
        "AvailabilityTypes": {
            "type": "string",
            "enum": [
                "Samba",
                "NFS",
                "Local",
                "HTTP",
                "HTTPS",
                "HTTPFS",
                "SFTP",
                "FTP"
            ]
        },
        "LenovoRemoteMapMedia": {
            "type": "object",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "additionalProperties": false,
            "properties": {
                "@odata.context": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/context"
                },
                "@odata.id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/id"
                },
                "@odata.type": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/type"
                },
                "Id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Id",
                    "readonly": true
                },
                "Description": {
                    "anyOf": [
                        {
                            "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Description"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "readonly": true
                },
                "Name": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Name",
                    "readonly": true
                },
                "FilePath": {
                    "type": "string",
                    "readonly": true,
                    "description": "File path of the map image"
                },
                "Type": {
                    "$ref": "#/definitions/AvailabilityTypes",
                    "readonly": true,
                    "description": "The map type of the image"
                },
                "Username": {
                    "type": "string",
                    "readonly": true,
                    "description": "Username to access the file path, available for Samba, HTTP/HTTPS, SFTP/FTP"
                },
                "Password": {
                    "type": "string",
                    "readonly": true,
                    "description": "Password to access the file path, password should be encrypted after object creation, available for Samba, HTTP/HTTPS, SFTP/FTP"
                },
                "Domain": {
                    "type": "string",
                    "readonly": true,
                    "description": "Domain of the username to access the file path, available for Samba only"
                },
                "Readonly": {
                    "type": "boolean",
                    "readonly": true,
                    "description": "It indicates the map image status is readonly or read/write"
                },
                "Options": {
                    "type": "string",
                    "readonly": true,
                    "description": "It indicates the mount options to map the image of the file path, available for Samba and NFS only"
                },
                "Owner": {
                    "type": "string",
                    "readonly": true,
                    "description": "Owner of the map image"
                },
                "Mounted": {
                    "type": "boolean",
                    "readonly": true,
                    "description": "It indicates the map image is mounted or not"
                }
            },
            "description": "This is the schema definition for the LenovoRemoteMapMedia resource."
        }
    },
