{
    "$schema": "http://redfish.dmtf.org/schemas/v1/redfish-schema.v1_1_0.json",
    "title": "#LenovoWatchdog.v1_0_0.LenovoWatchdog",
    "$ref": "#/definitions/LenovoWatchdog",
    "definitions": {
        "WatchdogType": {
            "type": "string",
            "enum": [
                "OSBootProcess",
                "OS",
                "BIOSBootProcess",
                "IPMI"
            ],
            "enumDescriptions": {
                "OSBootProcess": "OS Boot Process watchdog",
                "OS": "OS watchdog",
                "BIOSBootProcess": "BIOS Boot Process watchdog",
                "IPMI": "IPMI watchdog"
            }
        },
        "WatchdogState": {
            "type": "string",
            "enum": [
                "Enabled",
                "Disabled",
                "EnabledButOffline"
            ]
        },
        "LenovoWatchdog": {
            "type": "object",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "additionalProperties": false,
            "properties": {
                "@odata.context": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/context"
                },
                "@odata.id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/id"
                },
                "@odata.type": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/type"
                },
                "Id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Id",
                    "readonly": true
                },
                "Description": {
                    "anyOf": [
                        {
                            "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Description"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "readonly": true
                },
                "Name": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Name",
                    "readonly": true
                },
                "Type": {
                    "$ref": "#/definitions/WatchdogType",
                    "readonly": true
                },
                "TimerValueInSec": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "readonly": true,
                    "description": "The watch dog timer value."
                },
                "State": {
                    "$ref": "#/definitions/WatchdogState",
                    "readonly": true,
                    "description": "The watch dog state."
                },
                "TimeoutIntervalInSec": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "readonly": false,
                    "description": "The watchdog timeout interval. The time unit of timeout interval for OS Boot Process watchdog is second, for OS watchdog is second, for BIOS Boot Process watchdog is second, and for IPMI watchdog is second * 0.1. The valid values for OS watchdog timeout interval are 0/180/210/240/600 seconds. The valid values for OS Boot Process watchdog timeout interval are 0/30/60/90/150/180/210/240/270/300/450/600/900/1200/1800/3600/7200 seconds."
                },
                "TimerExpired": {
                    "type": "boolean",
                    "readonly": true,
                    "description": "It represents watchdog timer is expired."
                }
            },
            "description": "This is the schema definition for the watch dog resource. It represents the properties of a watch dog of a System."
        }
    },
    "copyright": "Copyright (C) 2015 - present Lenovo.  All Rights reserved."
}