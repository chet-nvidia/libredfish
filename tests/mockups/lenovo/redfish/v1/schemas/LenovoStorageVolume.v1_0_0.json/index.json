{
    "$schema": "http://redfish.dmtf.org/schemas/v1/redfish-schema.v1_1_0.json",
    "title": "#LenovoStorageVolume.v1_0_0.LenovoStorageVolume",
    "$ref": "#/definitions/LenovoStorageVolume",
    "definitions": {
        "StorageStatusType": {
            "type": "string",
            "enum": [
                "Offline",
                "PartiallyDegraded",
                "Degraded",
                "Optimal",
                "Unknown"
            ],
            "enumDescriptions": {
                "Offline": "This storage pool is Offline",
                "PartiallyDegraded": "This storage pool is partially degraded",
                "Degraded": "This storage pool is degraded",
                "Optimal": "This storage pool is optimal",
                "Unknown": "This storage pool is Unknown"
            }
        },
        "LenovoStorageVolume": {
            "type": "object",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "additionalProperties": false,
            "properties": {
                "@odata.context": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/context"
                },
                "@odata.id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/id"
                },
                "@odata.type": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/type"
                },
                "VolumeUID": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "readonly": true,
                    "description": "The volume UID of the storage volume."
                },
                "Status": {
                    "$ref": "#/definitions/StorageStatusType",
                    "readonly": true
                },
                "Name": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "readonly": true,
                    "description": "The name of the storage volume."
                },
                "StripeSizeByte": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "readonly": true,
                    "description": "The stripe size of the storage volume."
                },
                "Bootable": {
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "readonly": true,
                    "description": "This indicates whether the storage volume is bootable."
                },
                "BlockSize": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "readonly": true,
                    "description": "The block size of the storage volume."
                },
                "NumberOfBlocks": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "readonly": true,
                    "description": "The number of blocks of the storage volume."
                },
                "ReadPolicy": {
                    "type": "string",
                    "enum": [
                        "NoReadAhead",
                        "ReadAhead",
                        "AdaptiveReadAhead"
                    ],
                    "enumDescriptions": {
                        "NoReadAhead": "No Read Ahead policy",
                        "ReadAhead": "Read Ahead policy",
                        "AdaptiveReadAhead": "Adaptive Read Ahead policy"
                    }
                },
                "WritePolicy": {
                    "type": "string",
                    "enum": [
                        "WriteThrough",
                        "AlwaysWriteBack",
                        "WriteBackWithBBU"
                    ],
                    "enumDescriptions": {
                        "WriteThrough": "Write Through policy",
                        "AlwaysWriteBack": "Write Back policy",
                        "WriteBackWithBBU": "Write With Battery Backup Unit (BBU) policy"
                    }
                },
                "IOPolicy": {
                    "type": "string",
                    "enum": [
                        "DirectIO",
                        "CachedIO"
                    ],
                    "enumDescriptions": {
                        "DirectIO": "Direct IO policy",
                        "CachedIO": "Cached IO policy"
                    }
                },
                "AccessPolicy": {
                    "type": "string",
                    "enum": [
                        "ReadWrite",
                        "ReadOnly",
                        "Blocked"
                    ],
                    "enumDescriptions": {
                        "ReadWrite": "Read Write policy",
                        "ReadOnly": "Read Only policy",
                        "Blocked": "Blocked policy"
                    }
                },
                "DriveCachePolicy": {
                    "type": "string",
                    "enum": [
                        "Unchanged",
                        "Enable",
                        "Disable"
                    ],
                    "enumDescriptions": {
                        "Unchanged": "The policy remains unchanged",
                        "Enable": "Enable the policy",
                        "Disable": "Disable the policy"
                    }
                },
                "BackgroundInitialization": {
                    "type": "string",
                    "enum": [
                        "Disable",
                        "Quick",
                        "Full"
                    ],
                    "enumDescriptions": {
                        "Disable": "No initialization",
                        "Quick": "Quick initialization",
                        "Full": "Full initialization"
                    }
                },
                "RefKey": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "readonly": true,
                    "description": "The reference key of the storage volume."
                },
                "volumeId": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "readonly": true,
                    "description": "The volumeId of the storage volume."
                },
                "RaidLevel": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "readonly": true,
                    "description": "The raid level of the storage volume."
                },
                "Links": {
                    "type": "object",
                    "patternProperties": {
                        "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                            "type": [
                                "array",
                                "boolean",
                                "number",
                                "null",
                                "object",
                                "string"
                            ],
                            "description": "This property shall specify a valid odata or Redfish property."
                        }
                    },
                    "additionalProperties": false,
                    "properties": {
                        "Pool": {
                            "$ref": "/schemas/v1/Lenovo/LenovoStoragePool.v1_0_0.json#/definitions/LenovoStoragePool",
                            "readonly": true,
                            "description": "The storage pool hosting this storage volume."
                        }
                    }
                }
            },
            "description": "This is the schema definition for the LenovoStorageVolume resource."
        }
    },
