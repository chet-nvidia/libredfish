{
    "$schema": "http://redfish.dmtf.org/schemas/v1/redfish-schema.v1_1_0.json",
    "title": "#LenovoDeviceInfo.v1_0_0.LenovoDeviceInfo",
    "$ref": "#/definitions/LenovoDeviceInfo",
    "definitions": {
        "LenovoDeviceInfo": {
            "type": "object",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "additionalProperties": false,
            "properties": {
                "Location": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.v1_4_0.json#/definitions/Location",
                    "readonly": true,
                    "description": "This indicates device location information.",
                    "longDescription": "The value of this property shall indicate device location information."
                },
                "UUID": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/UUID",
                    "readonly": true,
                    "description": "This indicates Universal Unique ID of device.",
                    "longDescription": "The value of this property shall indicate Universal Unique ID of device."
                }
            }
        }
    },
