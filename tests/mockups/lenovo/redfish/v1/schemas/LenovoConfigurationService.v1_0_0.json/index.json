{
    "$schema": "http://redfish.dmtf.org/schemas/v1/redfish-schema.v1_1_0.json",
    "title": "#LenovoConfigurationService.v1_0_0.LenovoConfigurationService",
    "definitions": {
        "LenovoConfigurationService": {
            "type": "object",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "additionalProperties": false,
            "properties": {
                "@odata.context": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/context"
                },
                "@odata.id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/id"
                },
                "@odata.type": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/type"
                },
                "Id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Id",
                    "readonly": true
                },
                "Description": {
                    "anyOf": [
                        {
                            "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Description"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "readonly": true
                },
                "Name": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Name",
                    "readonly": true
                },
                "BackupStatus": {
                    "type": "string",
                    "readonly": true,
                    "description": "Indicate the detailed status of backup operation in redfish."
                },
                "RestoreStatus": {
                    "type": "string",
                    "readonly": true,
                    "description": "Indicate the detailed status of restore operation in redfish."
                },
                "Descriptor": {
                    "$ref": "/schemas/v1/Lenovo/LenovoConfigurationDescriptor.json#/definitions/LenovoConfigurationDescriptor",
                    "description": "A reference to the descriptor resource."
                },
                "Actions": {
                    "type": "object",
                    "patternProperties": {
                        "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                            "type": [
                                "array",
                                "boolean",
                                "number",
                                "null",
                                "object",
                                "string"
                            ],
                            "description": "This property shall specify a valid odata or Redfish property."
                        }
                    },
                    "additionalProperties": false,
                    "properties": {
                        "#LenovoConfigurationService.BackupConfiguration": {
                            "$ref": "#/definitions/BackupConfiguration"
                        },
                        "#LenovoConfigurationService.RestoreConfiguration": {
                            "$ref": "#/definitions/RestoreConfiguration"
                        },
                        "#LenovoConfigurationService.ResetToDefault": {
                            "$ref": "#/definitions/ResetToDefault"
                        },
                        "#LenovoConfigurationService.GetRestoreConfigurationDetails": {
                            "$ref": "#/definitions/GetRestoreConfigurationDetails"
                        }
                    }
                }
            }
        },
        "GetRestoreConfigurationDetails": {
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "title": {
                    "type": "string",
                    "description": "Friendly action name"
                },
                "target": {
                    "type": "string",
                    "format": "uri",
                    "description": "Link to invoke action"
                },
                "Response": {
                    "$ref": "#/definitions/GetRestoreConfigDetailsResp",
                    "description": "Indicates what data will be response."
                }
            }
        },
        "BackupConfiguration": {
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "title": {
                    "type": "string",
                    "description": "Friendly action name"
                },
                "target": {
                    "type": "string",
                    "format": "uri",
                    "description": "Link to invoke action"
                },
                "Response": {
                    "$ref": "#/definitions/BackupConfigResp",
                    "description": "Indicates what data will be response."
                },
                "EncryptScope": {
                    "$ref": "#/definitions/EncryptScopeItem",
                    "description": "Indicates the scope of encrypt the configuration file."
                },
                "Passphrase": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "The passphrase is used to encrypt values in the file. When the user restores a configuration, the password will be asked."
                }
            }
        },
        "EncryptScopeItem": {
            "type": "string",
            "enum": [
                "WholeFile",
                "SensitiveInfo"
            ]
        },
        "GetRestoreConfigDetailsResp": {
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "content": {
                    "type": "string",
                    "description": "Indicates content of the last restore configuration settings list and the execution result."
                }
            },
            "description": "This object is used to represent the response of the action GetRestoreConfigurationDetails."
        },
        "BackupConfigResp": {
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "data": {
                    "type": "string",
                    "description": "Indicates content of the backed up configuration data of the managed system element."
                }
            },
            "description": "This object is used to represent the response of the action BackupConfiguration."
        },
        "RestoreConfiguration": {
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "title": {
                    "type": "string",
                    "description": "Friendly action name"
                },
                "target": {
                    "type": "string",
                    "format": "uri",
                    "description": "Link to invoke action"
                },
                "Response": {
                    "$ref": "#/definitions/RestoreConfigResp",
                    "description": "Indicates what data will be response."
                },
                "ConfigContent": {
                    "type": "string",
                    "description": "Content of configuration file to be restored"
                },
                "Passphrase": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Passphrase to be provided when the backup file is created and restored"
                }
            }
        },
        "RestoreConfigResp": {
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "ErrorInfo": {
                    "type": "string",
                    "description": "Indicates details about any specific failures that occurred. Only retureed when the action fails."
                }
            },
            "description": "This object is used to represent the response of the action RestoreConfiguration."
        },
        "ResetToDefault": {
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "title": {
                    "type": "string",
                    "description": "Friendly action name"
                },
                "target": {
                    "type": "string",
                    "format": "uri",
                    "description": "Link to invoke action"
                }
            },
            "description": "Reset all IMM settings to factory defaults. All the IMM configuration will be cleared."
        }
