{
    "$schema": "http://redfish.dmtf.org/schemas/v1/redfish-schema.v1_1_0.json",
    "title": "#LenovoScheduledPowerAction.v1_0_0.LenovoScheduledPowerAction",
    "$ref": "#/definitions/LenovoScheduledPowerAction",
    "definitions": {
        "ScheduleType": {
            "type": "string",
            "enum": [
                "On",
                "GracefulShutdown",
                "GracefulRestart"
            ],
            "enumDescriptions": {
                "On": "Power on server",
                "GracefulShutdown": "Shut down OS and power off server",
                "GracefulRestart": "Shut down OS and restart server"
            }
        },
        "WeekDay": {
            "type": "string",
            "enum": [
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "Saturday",
                "Sunday"
            ]
        },
        "IntervalType": {
            "type": "string",
            "enum": [
                "Daily",
                "Weekly"
            ]
        },
        "LenovoScheduledPowerAction": {
            "type": "object",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "additionalProperties": false,
            "properties": {
                "@odata.context": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/context"
                },
                "@odata.id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/id"
                },
                "@odata.type": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/type"
                },
                "Id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Id",
                    "readonly": true
                },
                "Description": {
                    "anyOf": [
                        {
                            "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Description"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "readonly": true
                },
                "Name": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Name",
                    "readonly": true
                },
                "Activated": {
                    "type": "boolean",
                    "readonly": false,
                    "description": "It indicates whether the scheduled power action is activated."
                },
                "Type": {
                    "$ref": "#/definitions/ScheduleType",
                    "readonly": true
                },
                "Interval": {
                    "$ref": "#/definitions/IntervalType",
                    "readonly": false,
                    "description": "Indicate the frequency how often automatically have a new power action.The value maybe 'Daily' or 'Weekly'."
                },
                "Weekday": {
                    "$ref": "#/definitions/WeekDay",
                    "readonly": false,
                    "description": "When 'Interval' is equal to 'weekly', the value should indicate one day in seven days."
                },
                "Time": {
                    "type": "string",
                    "readonly": false,
                    "description": "The time to take the scheduled power action."
                }
            },
            "description": "This is the schema definition for the watch dog resource. It represents the properties of a watch dog of a System."
        }
    },
