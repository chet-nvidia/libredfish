{
    "$schema": "http://redfish.dmtf.org/schemas/v1/redfish-schema.v1_1_0.json",
    "title": "#LenovoFoDKey.v1_0_0.LenovoFoDKey",
    "$ref": "#/definitions/LenovoFoDKey",
    "definitions": {
        "IdentifierType": {
            "type": "string",
            "enum": [
                "MTSN",
                "MAC",
                "EmulexASIC"
            ],
            "enumDescriptions": {
                "MTSN": "The machine type and serial number",
                "MAC": "MAC address",
                "EmulexASIC": "The type of Emulex ASIC"
            }
        },
        "KeyStatus": {
            "type": "string",
            "enum": [
                "Valid",
                "Invalid",
                "Validating",
                "Expired",
                "ReachUseLimit",
                "NeedValidationElsewhere"
            ]
        },
        "LenovoFoDKey": {
            "type": "object",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "additionalProperties": false,
            "properties": {
                "@odata.context": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/context"
                },
                "@odata.id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/id"
                },
                "@odata.type": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/type"
                },
                "Id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Id",
                    "readonly": true
                },
                "Description": {
                    "anyOf": [
                        {
                            "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Description"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "readonly": true
                },
                "Name": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Name",
                    "readonly": true
                },
                "IdTypes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IdentifierType"
                    },
                    "readonly": true,
                    "description": "The identifier types of the FoD key"
                },
                "Identifier": {
                    "type": "string",
                    "readonly": true,
                    "description": "The identifier of the FoD key"
                },
                "DescTypeCode": {
                    "type": "number",
                    "readonly": true,
                    "description": "The feature description type code"
                },
                "Status": {
                    "$ref": "#/definitions/KeyStatus",
                    "readonly": true,
                    "description": "The key status of the FoD key"
                },
                "Expires": {
                    "type": "string",
                    "readonly": true,
                    "description": "The expire time of the FoD key"
                },
                "UseCount": {
                    "type": "number",
                    "readonly": false,
                    "description": "The use count of the FoD key"
                },
                "UseLimit": {
                    "type": "number",
                    "readonly": true,
                    "description": "The use limit of the FoD key"
                },
                "Bytes": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    },
                    "readonly": true,
                    "description": "Content of FoD activation key."
                }
            },
            "requiredOnCreate": [
                "Bytes"
            ],
            "description": "This is the schema definition for the FoDKey resource.  It represents the properties of a FoDKey."
        }
    },
