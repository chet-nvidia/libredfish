{
    "$schema": "http://redfish.dmtf.org/schemas/v1/redfish-schema.v1_1_0.json",
    "title": "#LenovoSecurityService.v1_0_0.LenovoSecurityService",
    "$ref": "#/definitions/LenovoSecurityService",
    "definitions": {
        "LenovoSecurityService": {
            "type": "object",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "additionalProperties": false,
            "properties": {
                "@odata.context": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/context"
                },
                "@odata.id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/id"
                },
                "@odata.type": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/type"
                },
                "Id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Id",
                    "readonly": true
                },
                "Description": {
                    "anyOf": [
                        {
                            "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Description"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "readonly": true
                },
                "Name": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Name",
                    "readonly": true
                },
                "CryptographyManagement": {
                    "$ref": "#/definitions/CryptographyManagement",
                    "readonly": true,
                    "description": "Represents cryptography management in security service.",
                    "longDescription": "The value of this property shall represent cryptography management in security service."
                },
                "Configurator": {
                    "$ref": "#/definitions/SecureConfigurator",
                    "description": "Represents security configurations.",
                    "longDescription": "The value of this property shall indicate the information about security configurations."
                },
                "EncapSettings": {
                    "$ref": "#/definitions/EncapSettings",
                    "description": "Represents settings of encapsulation service.",
                    "longDescription": "The value of this property shall indicate the settings of encapsulation service."
                },
                "SSLSettings": {
                    "$ref": "#/definitions/SSLSettings",
                    "description": "Represents settings of SSL.",
                    "longDescription": "The value of this property shall indicate the settings of SSL."
                },
                "Actions": {
                    "type": "object",
                    "patternProperties": {
                        "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                            "type": [
                                "array",
                                "boolean",
                                "number",
                                "null",
                                "object",
                                "string"
                            ],
                            "description": "This property shall specify a valid odata or Redfish property."
                        }
                    },
                    "additionalProperties": false,
                    "properties": {
                        "#LenovoSecurityService.CreateKeyPair": {
                            "$ref": "#/definitions/CreateKeyPair"
                        }
                    },
                    "description": "This object is used to define Lenovo extend security actions."
                }
            },
            "description": "This is Lenovo extended Security service properties."
        },
        "CryptographyManagement": {
            "type": "object",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "additionalProperties": false,
            "properties": {
                "MinTLSLevel": {
                    "$ref": "#/definitions/TLSLevel",
                    "readonly": false,
                    "description": "Indicates the enabled minimum TLS level.",
                    "longDescription": "The value of this property shall be a string indicating the enabled minimum TLS level."
                }
            },
            "description": "This is used to represent cryptography management in security service."
        },
        "TLSLevel": {
            "type": "string",
            "enum": [
                "TLSLevel1_0",
                "TLSLevel1_1",
                "TLSLevel1_2"
            ]
        },
        "SecureConfigurator": {
            "type": "object",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "additionalProperties": false,
            "properties": {
                "FWRollback": {
                    "type": "string",
                    "enum": [
                        "Enabled",
                        "Disabled"
                    ],
                    "readonly": false,
                    "description": "Represents secure roll back status."
                }
            },
            "description": "This is uesd to represent the host name or IP address and port number of SKLM servers."
        },
        "EncapSettings": {
            "type": "object",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "additionalProperties": false,
            "properties": {
                "EncapMode": {
                    "$ref": "#/definitions/EncapMode",
                    "readonly": false,
                    "description": "Represents whether the system is in encapsulation mode, and which encapsulation mode it is.",
                    "longDescription": "The value of this property shall represent whether the system is in encapsulation mode, and which encapsulation mode it is."
                },
                "WhiteList": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "readonly": false,
                    "description": "Represents a white-list of network traffic. Each item of this array shall be an IPv4/IPv6 address.",
                    "longDescription": "The value of this property shall represent a white-list of network traffic. Each item of this array shall be an IPv4/IPv6 address."
                }
            },
            "description": "This object is used to represent the settings of encapsulation mode."
        },
        "EncapMode": {
            "type": "string",
            "enum": [
                "NormalMode",
                "EncapsulationLiteMode"
            ]
        },
        "SSLSettings": {
            "type": "object",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "additionalProperties": false,
            "properties": {
                "EnableHttps": {
                    "type": "boolean",
                    "readonly": false,
                    "description": "Represents enable or disable SSL for web http.",
                    "longDescription": "The value of this property shall represent enable or disable SSL for web http."
                },
                "EnableLDAPS": {
                    "type": "boolean",
                    "readonly": false,
                    "description": "Represents enable or disable SSL for LDAP-Client.",
                    "longDescription": "The value of this property shall represent enable or disable SSL for LDAP-Client."
                },
                "EnableCIMOverHttps": {
                    "type": "boolean",
                    "readonly": false,
                    "description": "Represents enable or disable SSL for CIM-XML-Http server.",
                    "longDescription": "The value of this property shall represent enable or disable SSL for CIM-XML-Http server."
                }
            },
            "description": "This object is used to represent the settings of SSL."
        },
        "CreateKeyPair": {
            "type": "object",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "additionalProperties": false,
            "properties": {
                "title": {
                    "type": "string",
                    "description": "Friendly action name"
                },
                "target": {
                    "type": "string",
                    "format": "uri",
                    "description": "Link to invoke action"
                },
                "Service": {
                    "$ref": "#/definitions/ServiceName",
                    "description": "Indicates for which Service this certificate applies."
                }
            },
            "description": "This action is used to create a key pair for SSH server."
        },
        "ServiceName": {
            "type": "string",
            "enum": [
                "SSH_SVR"
            ],
            "enumDescriptions": {
                "SSH_SVR": "Indicates SSH server."
            }
        }
    },
    "copyright": "Copyright (C) 2015 - present Lenovo.  All Rights reserved."
}