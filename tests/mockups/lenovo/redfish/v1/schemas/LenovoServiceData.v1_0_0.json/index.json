{
    "$schema": "http://redfish.dmtf.org/schemas/v1/redfish-schema.v1_1_0.json",
    "title": "#LenovoServiceData.v1_0_0",
    "$ref": "#/definitions/LenovoServiceData",
    "definitions": {
        "LenovoServiceData": {
            "type": "object",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "additionalProperties": false,
            "properties": {
                "@odata.context": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/context"
                },
                "@odata.id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/id"
                },
                "@odata.type": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata.4.0.0.json#/definitions/type"
                },
                "Id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Id",
                    "readonly": true
                },
                "Description": {
                    "anyOf": [
                        {
                            "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Description"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "readonly": true
                },
                "Name": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Name",
                    "readonly": true
                },
                "CaptureTimeout": {
                    "type": "number",
                    "readonly": true,
                    "description": "The duration of maximum time for initializing and collecting the FFDC data."
                },
                "FileTransferTimeout": {
                    "type": "number",
                    "readonly": true,
                    "description": "The duration of maximum time for exporting the FFDC collected data."
                },
                "DataCollectionType": {
                    "$ref": "#/definitions/CollectionType",
                    "readonly": false,
                    "description": "The supported collection type."
                },
                "ExportingSchemes": {
                    "$ref": "#/definitions/SchemesType",
                    "readonly": false,
                    "description": "The supported file transfer mode."
                },
                "ExportProgress": {
                    "type": "string",
                    "readonly": true,
                    "description": "Indicates collection progress. Only when it's 100%, the FFDC gotten from 'ExportURI' is available."
                },
                "IsScreenAvailable": {
                    "type": "boolean",
                    "readonly": true,
                    "description": "Indicates whether an OS Failure Screen has been captured or not."
                },
                "Actions": {
                    "type": "object",
                    "patternProperties": {
                        "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                            "type": [
                                "array",
                                "boolean",
                                "number",
                                "null",
                                "object",
                                "string"
                            ],
                            "description": "This property shall specify a valid odata or Redfish property."
                        }
                    },
                    "additionalProperties": false,
                    "properties": {
                        "#LenovoServiceData.ExportFFDCData": {
                            "$ref": "#/definitions/ExportFFDCData"
                        },
                        "#LenovoServiceData.ExportLatestOSFailureScreen": {
                            "$ref": "#/definitions/ExportLatestOSFailureScreen"
                        },
                        "#LenovoServiceData.ExportHealthReport": {
                            "$ref": "#/definitions/ExportHealthReport"
                        }
                    },
                    "readonly": true,
                    "description": "The Actions object contains the available custom actions on this resource."
                }
            },
            "description": "This schema defines a resource for user to collect service Data.",
            "longDescription": "This resource shall be used to represent resources that is used to collect service Data,including FFDC and latest OS failure screen. "
        },
        "ExportFFDCData": {
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "title": {
                    "type": "string",
                    "description": "Friendly action name"
                },
                "target": {
                    "type": "string",
                    "format": "uri",
                    "description": "Link to invoke action"
                },
                "DataCollectionType": {
                    "$ref": "#/definitions/CollectionType",
                    "description": "The FFDC data collection type."
                },
                "InitializationNeeded": {
                    "type": "Boolean",
                    "description": "Indicate whether the FFDC shall do initialization before collection."
                },
                "Username": {
                    "type": "string",
                    "description": "The username for security credential to the URI. It can be NULL if not required."
                },
                "Password": {
                    "type": "string",
                    "description": "The password for security credential to the URI. It can be NULL if not required."
                },
                "ExportURI": {
                    "type": "string",
                    "format": "URI",
                    "description": "Indicates the location to which FFDC shall be exported."
                },
                "Response": {
                    "$ref": "#/definitions/FFDCData",
                    "description": "Indicates what data shall be responded."
                }
            },
            "description": "If 'ExportURI,Username,Password' are all NULL, the action will directly return the content of FFDC."
        },
        "ExportLatestOSFailureScreen": {
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "title": {
                    "type": "string",
                    "description": "Friendly action name"
                },
                "target": {
                    "type": "string",
                    "format": "uri",
                    "description": "Link to invoke action"
                },
                "Response": {
                    "$ref": "#/definitions/FailureScreen",
                    "description": "Indicates what data will be response."
                }
            },
            "description": "The OS watchdog feature must be enabled to capture the OS failure screen."
        },
        "ExportHealthReport": {
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "title": {
                    "type": "string",
                    "description": "Friendly action name"
                },
                "target": {
                    "type": "string",
                    "format": "uri",
                    "description": "Link to invoke action"
                },
                "Response": {
                    "$ref": "#/definitions/HealthReport",
                    "description": "Indicates what data will be response."
                }
            },
            "description": "The action to export system health report."
        },
        "FFDCData": {
            "type": "object",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "additionalProperties": false,
            "properties": {
                "DownloadURI": {
                    "type": "string",
                    "format": "uri",
                    "description": "Indicates a URI for downloading file",
                    "longDescription": "The value of this property shall indicate a URI for downloading file of FFDC data"
                }
            },
            "description": "This object is uesd to represent the action response data."
        },
        "FailureScreen": {
            "type": "object",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "additionalProperties": false,
            "properties": {
                "DownloadURI": {
                    "type": "string",
                    "format": "uri",
                    "description": "Indicates a URI for downloading file",
                    "longDescription": "The value of this property shall indicate a URI for downloading file of failure screen"
                }
            },
            "description": "This object is uesd to represent the action response data."
        },
        "HealthReport": {
            "type": "object",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message|Privileges)\\.[a-zA-Z_][a-zA-Z0-9_.]+$": {
                    "type": [
                        "array",
                        "boolean",
                        "number",
                        "null",
                        "object",
                        "string"
                    ],
                    "description": "This property shall specify a valid odata or Redfish property."
                }
            },
            "additionalProperties": false,
            "properties": {
                "Report": {
                    "type": "string",
                    "description": "Indicates the health report xml.",
                    "longDescription": "The value of this property shall indicating the health report xml."
                }
            },
            "description": "This is uesd to represent the action response data."
        },
        "SchemesType": {
            "type": "string",
            "enum": [
                "TFTP",
                "SFTP"
            ]
        },
        "CollectionType": {
            "type": "string",
            "enum": [
                "ProcessorDump",
                "ServiceDataFile",
                "BootPOSTDump"
            ]
        }
    },
    "copyright": "Copyright (C) 2015 - present Lenovo.  All Rights reserved."
}