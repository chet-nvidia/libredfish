{
    "$schema": "http://redfish.dmtf.org/schemas/v1/redfish-schema.v1_1_0.json",
    "title": "#LenovoServerProfileService.v1_0_0.LenovoServerProfileService",
    "definitions": {
        "LenovoServerProfileService": {
            "type": "object",
